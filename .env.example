# Copy to .env for docker compose. Everything has a local default, so this is optional.
DATABASE_URL=postgresql://lecturelens:lecturelens@localhost:5432/lecturelens
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lectures
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Optional: enables Claude answers, chapters and flashcards. Without it, LectureLens falls back to extractive answers.
ANTHROPIC_API_KEY=
# Sign-in. Without SMTP_URL, sign-in links are printed in the API log.
SECRET_KEY=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
SMTP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
